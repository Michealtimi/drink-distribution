# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/beverage_distribution?schema=public"

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dashboard PIN (optional). If set, visitors must enter this PIN to access the app.
# Leave unset for no gate (all routes open). Example: DASHBOARD_PIN=1234
# DASHBOARD_PIN=1234

# Cron: set in production so only your scheduler can call /api/cron/follow-ups
# CRON_SECRET=your-random-secret

# Optional: WhatsApp welcome message when a new lead is created (whatsapp-web.js).
# Set to "true" to send a welcome message via WhatsApp; ensure you have scanned QR once (see WHATSAPP_INTEGRATION_PLAN.md).
# RATE LIMIT: Do not send more than ~50 messages per hour to avoid WhatsApp bans.
# WHATSAPP_WELCOME_ENABLED=false
