# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/beverage_distribution?schema=public"

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron: set in production so only your scheduler can call /api/cron/follow-ups
# CRON_SECRET=your-random-secret

# Optional: Axiom webhook auth (if using Axiom.ai)
# AXIOM_API_KEY=your-axiom-api-key
